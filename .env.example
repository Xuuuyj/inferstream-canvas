# ======================================================================
# 生产环境（canvas.openai.fit 正式部署）
# 复制成 .env 后把每个 <…> 换成真实值；占位符没换完会拒绝启动。APP_ENV=production 时：
# PUBLIC_HOST、SERVER_PUBLIC_IPS 必填；JWT_SECRET 至少 32 字节且不能是默认值；
# ADMIN_USERNAME 不能是 admin；ADMIN_PASSWORD 至少 16 位（管理员已建好时可留空）。
# APP_ENV 不写也按 production 处理；只有一字不差的 dev 才是开发模式，写成其他值会拒绝启动。
# 值里有 $ 时整段用单引号包起来，例如 ADMIN_PASSWORD='a$b…'：docker compose 和 go run 都会把没加引号的 $ 当变量展开。
# ======================================================================
APP_ENV=production

# 本站域名和服务器公网 IP（多个 IP 用英文逗号分隔），/api/proxy-image 不会代理到这些地址，防止绕回本站。
# 本站域名在启动时解析一次并缓存，解析不出来时 /api/proxy-image 拒绝代理。
PUBLIC_HOST=<本站域名，例如 canvas.openai.fit>
SERVER_PUBLIC_IPS=<服务器公网 IP>

# 管理员账号，首次启动时自动创建。
ADMIN_USERNAME=<管理员用户名，不能是 admin>
ADMIN_PASSWORD=<至少 16 位的强密码>

# 登录令牌的签名密钥（至少 32 字节，可用 openssl rand -base64 48 生成）和有效小时数。
JWT_SECRET=<随机密钥>
JWT_EXPIRE_HOURS=72

# docker-compose.yml 用的镜像标签（fit-canvas:<CANVAS_TAG>），发版脚本切换版本时改它；不写就是 local。
# CANVAS_TAG=local

# ======================================================================
# 通用（生产和开发都用）
# ======================================================================
# 后端监听地址和端口，默认只监听本机 127.0.0.1:8080，由前端或宿主机反代访问。
# 这两项只对 go run 生效：Docker 镜像里后端固定 127.0.0.1:8080，前端固定 127.0.0.1:3000（APP_ENV=dev 时前端改听 0.0.0.0:3000）。
# BIND_ADDR=127.0.0.1
# PORT=8080

# 前端开发代理默认使用 http://127.0.0.1:8080，如后端开发端口不同，启动前端时可单独设置 API_BASE_URL。
# API_BASE_URL=http://127.0.0.1:8080

# openai.fit 公开模型目录的地址，一般不用改。
# FIT_BASE_URL=https://openai.fit

# 「用 openai.fit 账号自动登录画布」的共享密钥：和 openai.fit 服务器上的 CANVAS_CONNECT_SECRET 填同一个值（openssl rand -base64 48 生成），
# 只写在服务器的 /opt/canvas/.env，不进仓库。不填就不自动登录画布账号（登录页不显示「用 openai.fit 登录」），
# 但浏览器照样能从 openai.fit 桥接页取用户自己的令牌。
# APP_ENV=production 时填了就要至少 32 字节，而且 FIT_BASE_URL 必须是 https://（换取身份的请求带着这个密钥）。
# 画布浏览器从 openai.fit 桥接页拿一次性登录码，画布后端带这个密钥去 openai.fit 换用户身份；openai.fit 不返回令牌，令牌只在用户浏览器里。
# FIT_CONNECT_SECRET=

# 每个 IP 每 24 小时最多注册成功几个账号（注册失败不算），默认 10，填 0 不限；超了提示「同一网络（IP）24 小时内最多注册 N 个账号」。
# 计数只在后端内存里（单实例部署），后端重启或发版后清零。注册接口另有每个 IP 每分钟 5 次的限流。
# REGISTER_DAILY_LIMIT_PER_IP=10

# 数据库配置，默认使用本地 SQLite。
STORAGE_DRIVER=sqlite
# sqlite: DATABASE_DSN=data/infinite-canvas.db
# Docker 部署时建议使用绝对路径，避免工作目录变化后写入临时库：DATABASE_DSN=/app/data/infinite-canvas.db
# mysql 目标库不存在时会尝试自动创建，账号需有 CREATE 权限。
# mysql: DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/infinite_canvas?parseTime=true
# postgres 目标库不存在时会尝试自动创建，账号需有 CREATEDB 权限。
# postgres: DATABASE_DSN=postgres://user:password@127.0.0.1:5432/infinite_canvas?sslmode=disable
DATABASE_DSN=data/infinite-canvas.db

# ======================================================================
# 本机开发（go run 或 docker-compose.local.yml）：取消下面这段的注释即可。
# 同名配置以写在后面的为准，上面的生产段可以不动；不要在服务器上打开这一段。
# JWT_SECRET 留空时每次启动随机生成，重启后要重新登录。
# ======================================================================
# APP_ENV=dev
# PUBLIC_HOST=
# SERVER_PUBLIC_IPS=
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=infinite-canvas
# JWT_SECRET=
